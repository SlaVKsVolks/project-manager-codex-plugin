  "intervention_decision": {
    "mode": "reframe",
    "baseline_structural_findings": [
      {
        "id": "health-state-absent",
        "category": "information-architecture",
        "observation": "Compact and wide baselines lead with capability promotion while the generated environment-health state has no visible route region."
      },
      {
        "id": "health-evidence-model-missing",
        "category": "content-model",
        "observation": "The baseline does not expose freshness, coordination gate, heartbeat readiness, stability totals, finding codes, or the loaded-turn evidence boundary."
      },
      {
        "id": "primary-action-misses-health-task",
        "category": "action-ownership",
        "observation": "The first primary action explores the roadmap instead of taking the operator to the environment-health evidence required by the declared task."
      }
    ],
    "selected_scopes": [
      "information-architecture",
      "content-model",
      "action-ownership",
      "visual-system"
    ],
    "rationale": "Reframe the first scan around current health, freshness, and evidence limits; give the health section one direct navigation action before retaining the roadmap and documentation as supporting context."
  },
